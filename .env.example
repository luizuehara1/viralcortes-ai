# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/viralcortes"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-this"
NEXTAUTH_URL="http://localhost:3000"

# URL pública canônica do app — usada para montar os redirects de OAuth
# (YouTube/Instagram) em vez de confiar no host da requisição, que pode vir
# errado atrás de um proxy reverso (ex.: Railway). Só APP_URL é obrigatória;
# as outras duas existem por convenção/compatibilidade — ver src/lib/app-url.ts
# (prioridade: APP_URL > NEXT_PUBLIC_APP_URL > NEXTAUTH_URL).
# Em produção, NUNCA aponte para localhost.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic Claude API (para análise de cortes virais)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI Whisper API (para transcrição)
# Alternativa: use WhisperX local (ver README)
OPENAI_API_KEY="sk-..."

# Redis (para BullMQ - fila de processamento)
REDIS_URL="redis://localhost:6379"

# Storage local (MVP) - pasta raiz do projeto
UPLOAD_DIR="./uploads"
CLIPS_DIR="./clips"

# Tamanho máximo de upload (em bytes) - padrão 10GB
MAX_UPLOAD_SIZE=10737418240

# FFmpeg path (se não estiver no PATH do sistema)
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# yt-dlp path — deixe SEM essa variável (ou "yt-dlp") em produção/Docker/
# Railway, onde o Dockerfile já instala via pip e deixa no PATH. Um caminho
# do Windows aqui (ex.: "C:/Users/.../yt-dlp.exe") só faz sentido em dev
# local no Windows, nunca em produção.
# YTDLP_PATH="yt-dlp"

# YouTube OAuth (Google Cloud Console → APIs & Services → Credentials)
# Redirect URI cadastrada no Google deve ser IDÊNTICA a GOOGLE_REDIRECT_URI abaixo.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"
YOUTUBE_UPLOAD_SCOPE="https://www.googleapis.com/auth/youtube.upload"

# Chave para cifrar tokens OAuth em repouso (AES-256-GCM, hex de 32 bytes).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="generate-a-32-byte-hex-key"

# Instagram OAuth — Instagram API with Instagram Login (Instagram Business
# Login). Login direto com a conta profissional do Instagram, sem Página do
# Facebook e sem o App ID principal da Meta no meio.
# Meta for Developers → App → Instagram → API setup with Instagram login.
# ATENÇÃO: INSTAGRAM_APP_ID/SECRET são DIFERENTES do App ID/Secret "de
# Facebook" do mesmo app — pegue os valores mostrados nessa tela específica,
# senão o Instagram recusa com "Invalid platform app".
# Redirect URI cadastrada nessa tela deve ser IDÊNTICA a INSTAGRAM_REDIRECT_URI abaixo.
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
INSTAGRAM_SCOPES="instagram_business_basic,instagram_business_content_publish"

# Webhook da Meta/Instagram (rota separada do OAuth acima) — Callback URL
# cadastrada no painel deve ser <domínio>/api/webhooks/meta, com este mesmo
# Verify Token.
META_WEBHOOK_VERIFY_TOKEN="viralcortes_meta_verify_2026"

# TikTok OAuth — reservado para quando a integração for implementada.
# Hoje o TikTok só existe como plataforma de download (yt-dlp); não há
# rota /api/auth/tiktok/* nem lib/tiktok.ts ainda, então estas variáveis
# não são lidas por nenhum código.
# TIKTOK_CLIENT_KEY="your-tiktok-client-key"
# TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
# TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"
# TIKTOK_SCOPES="user.info.basic,video.publish"
